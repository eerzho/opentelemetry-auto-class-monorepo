{
  "name": "eerzho/opentelemetry-auto-class",
  "description": "OpenTelemetry auto-instrumentation for PHP class methods",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "php",
    "otel",
    "opentelemetry",
    "trace",
    "tracing",
    "instrumentation",
    "auto-instrumentation"
  ],
  "authors": [
    {
      "name": "Zhanbolat Yerkinbay",
      "email": "eerzho@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.2",
    "ext-opentelemetry": "*",
    "open-telemetry/api": "^1.0",
    "open-telemetry/sem-conv": "^1.32"
  },
  "require-dev": {
    "open-telemetry/sdk": "^1.0",
    "phpbench/phpbench": "^1.3",
    "phpunit/phpunit": "^10.0 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "OpenTelemetry\\Contrib\\Instrumentation\\Class\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OpenTelemetry\\Contrib\\Instrumentation\\Class\\Tests\\": "tests/",
      "OpenTelemetry\\Contrib\\Instrumentation\\Class\\Benchmarks\\": "benchmarks/"
    }
  },
  "config": {
    "sort-packages": true
  }
}
