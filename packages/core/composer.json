{
  "name": "eerzho/opentelemetry-auto-class",
  "description": "Trace what your methods received, returned, and threw — without writing a single span. No framework required.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "opentelemetry",
    "otel",
    "telemetry",
    "tracing",
    "traces",
    "distributed-tracing",
    "instrumentation",
    "auto-instrumentation",
    "observability",
    "apm",
    "monitoring",
    "php-attributes",
    "spans"
  ],
  "authors": [
    {
      "name": "Zhanbolat Yerkinbay",
      "email": "eerzho@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.2",
    "ext-opentelemetry": "*",
    "open-telemetry/api": "^1.0",
    "open-telemetry/sem-conv": "^1.33"
  },
  "require-dev": {
    "open-telemetry/sdk": "^1.0",
    "phpbench/phpbench": "^1.3",
    "phpunit/phpunit": "^10.0 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "Eerzho\\Instrumentation\\Class\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Eerzho\\Instrumentation\\Class\\Tests\\": "tests/",
      "Eerzho\\Instrumentation\\Class\\Benchmarks\\": "benchmarks/"
    }
  },
  "config": {
    "sort-packages": true
  }
}
