{
  "name": "eerzho/opentelemetry-auto-class-monorepo",
  "description": "Development monorepo for the opentelemetry-auto-class packages — the framework-agnostic core plus its Laravel and Symfony integrations, each published as a standalone package.",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Zhanbolat Yerkinbay",
      "email": "eerzho@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.2",
    "ext-opentelemetry": "*",
    "open-telemetry/api": "^1.0",
    "open-telemetry/sem-conv": "^1.33",
    "symfony/dependency-injection": "^6.0 || ^7.0 || ^8.0",
    "symfony/http-kernel": "^6.0 || ^7.0 || ^8.0",
    "illuminate/support": "^11.0 || ^12.0 || ^13.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.65",
    "illuminate/config": "^11.0 || ^12.0 || ^13.0",
    "nyholm/psr7": "^1.8",
    "open-telemetry/sdk": "^1.0",
    "phpbench/phpbench": "^1.3",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^10.0 || ^11.0",
    "symfony/http-client": "^7.4"
  },
  "replace": {
    "eerzho/opentelemetry-auto-class": "self.version",
    "eerzho/opentelemetry-auto-class-symfony": "self.version",
    "eerzho/opentelemetry-auto-class-laravel": "self.version"
  },
  "autoload": {
    "psr-4": {
      "Eerzho\\Instrumentation\\Class\\": "packages/core/src/",
      "Eerzho\\Instrumentation\\Class\\Symfony\\": "packages/symfony/src/",
      "Eerzho\\Instrumentation\\Class\\Laravel\\": "packages/laravel/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Eerzho\\Instrumentation\\Class\\Tests\\": "tests/",
      "Eerzho\\Instrumentation\\Class\\Benchmarks\\": "benchmarks/"
    }
  },
  "config": {
    "sort-packages": true
  }
}
